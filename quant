                ДЛЯ ПОПОЛНЕНИЯ ИНВЕНТАРЯ ПЕРЕДАЙТЕ ПОДАРКИ НА АККАУНТ <span class="username">@marketofferstelegram</span>
            </div>
            <button class="btn" id="close-modal">Хорошо</button>
        </div>
    </div>

    <script>
        // Переключение вкладок
        function switchTab(tabName, btnElement) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.getElementById('tab-' + tabName).classList.add('active');
            btnElement.classList.add('active');
        }

        // Выбор строки со звездами
        function selectStarRow(rowElement, starsText) {
            document.querySelectorAll('.star-row').forEach(row => {
                row.classList.remove('selected');
            });
            rowElement.classList.add('selected');

            const buyBtn = document.getElementById('buy-action-btn');
            buyBtn.textContent = `Buy ${starsText} Telegram Stars`;
        }

        // Выбор метода оплаты
        function selectPaymentMethod(cardElement) {
            document.querySelectorAll('.pay-method-card').forEach(card => {
                card.classList.remove('active');
            });
            cardElement.classList.add('active');
        }

        // Кнопка "Buy for myself"
        function setMyUsername() {
            const input = document.getElementById('username-input');
            input.value = "@my_account";
            validateUsername();
        }

        // Валидация юзернейма
        function validateUsername() {
            const input = document.getElementById('username-input');
            const container = document.getElementById('input-container');
            const errorMsg = document.getElementById('error-msg');
            const val = input.value.trim();

            const regex = /^@[a-zA-Z0-9_]{5,}$/;

            if (val === "" || regex.test(val)) {
                container.classList.remove('error');
                errorMsg.style.display = 'none';
            } else {
                container.classList.add('error');
                errorMsg.style.display = 'block';
            }
        }

        // Покупка NFT
        function buyNft(name, price) {
            alert(`Для покупки NFT "${name}" (${price}) недостаточно средств на балансе.`);
        }

        // Логика модального окна
        const modalOverlay = document.getElementById('modal-overlay');
        const topupBtn = document.getElementById('topup-btn');
        const closeModalBtn = document.getElementById('close-modal');

        topupBtn.addEventListener('click', () => {
            modalOverlay.style.display = 'flex';
        });

        closeModalBtn.addEventListener('click', () => {
            modalOverlay.style.display = 'none';
        });

        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) {
                modalOverlay.style.display = 'none';
            }
        });
    </script>
</body>
</html>
